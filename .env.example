# Copy to .env and fill in values before running docker-compose up
# This file contains ONLY Vault credentials and port bindings.
# All other secrets (DB password, LLM key, JWT key, MinIO key) live in Vault.

# Vault
VAULT_ROOT_TOKEN=dev-root-token

# Anthropic API key — replace with a real key for chat/RAG to work
# In CI this stays as placeholder; smoke test only checks health + auth + rag/search (returns empty)
SEED_LLM_API_KEY=sk-placeholder

# Ports (change if you have conflicts)
API_PORT=8000
CHATBOT_PORT=8501
MODELSERVER_PORT=8001
WIDGET_PORT=8080
HOST_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200
JAEGER_UI_PORT=16686
